{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/conventional-commit-guard.sh\"",
            "statusMessage": "Checking PR conventions"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/brainstorm-skill-worktree-first.sh\"",
            "statusMessage": "Enforcing worktree-first brainstorming"
          }
        ]
      },
      {
        "matcher": "mcp__.*__notion-(create-pages|update-page|create-comment)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notion-content-reminder.sh\"",
            "statusMessage": "Reminding to follow Notion content style"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/brainstorm-worktree-first.sh\"",
            "statusMessage": "Enforcing worktree-first brainstorming"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/engineering-principles.sh\"",
            "statusMessage": "Loading engineering principles"
          }
        ]
      }
    ]
  }
}
